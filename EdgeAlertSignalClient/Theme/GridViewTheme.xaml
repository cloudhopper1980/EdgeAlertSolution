<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- GridViewColumnHeader Style -->
    <Style x:Key="GridViewColumnHeaderStyle1" TargetType="{x:Type GridViewColumnHeader}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                    <Border Background="#004166" BorderThickness="0,0,0,1" BorderBrush="Black">
                        <TextBlock Text="{TemplateBinding Content}" 
                     Padding="5,5,5,0" 
                     Width="{TemplateBinding Width}" 
                     TextAlignment="Center" 
                     Foreground="White"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Define a base style for all GridViewColumnHeaders -->
    <!-- Base style for GridViewColumnHeader -->
    <Style x:Key="GridViewColumnHeaderBaseStyle" TargetType="GridViewColumnHeader">
        <!-- Set header background to #004166 -->
        <Setter Property="Background" Value="#004166"/>
        <!-- Set header foreground (text color) to white -->
        <Setter Property="Foreground" Value="White"/>
    </Style>
</ResourceDictionary>
