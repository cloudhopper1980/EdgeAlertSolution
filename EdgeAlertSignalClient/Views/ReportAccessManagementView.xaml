<UserControl x:Class="EdgeAlertSignalClient.Views.ReportAccessManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:EdgeAlertSignalClient.Views"
             xmlns:vm="clr-namespace:EdgeAlertSignalClient.ViewModels"
             xmlns:converters="clr-namespace:EdgeAlertSignalClient.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ReportAccessManagementViewModel, IsDesignTimeCreatable=False}"
             d:DesignHeight="450" d:DesignWidth="780" Background="#E2F0D9">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Theme/MenuButtonTheme.xaml"/>
                <ResourceDictionary Source="../Theme/TabTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Report Access Management" FontSize="20" FontWeight="Bold" Foreground="#004166" Margin="0,0,0,15"/>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Select User:"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold" Foreground="#004166" Margin="0,5,10,5"/>

            <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding UserSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,20,5"
                     ToolTip="Search users by name"
                     BorderBrush="#004166" BorderThickness="1"/>

            <ListBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" ItemsSource="{Binding FilteredUserNames}" SelectedItem="{Binding SelectedUserName}"
                     MaxHeight="100" Margin="0,0,20,0" BorderBrush="#004166" BorderThickness="1"/>

            <TextBlock Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Text="Select ODS Practice:"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold" Foreground="#004166" Margin="0,5,10,5"/>

            <ComboBox Grid.Row="1" Grid.Column="2" Grid.RowSpan="2" Grid.ColumnSpan="2" ItemsSource="{Binding OdsPractices}"
                      SelectedItem="{Binding SelectedOdsPractice}"
                      VerticalAlignment="Top" Height="30" BorderBrush="#004166" BorderThickness="1"/>
        </Grid>

        <GroupBox Grid.Row="2" Header="Current Permissions" Margin="0,0,0,15" BorderBrush="#004166">
            <ListView x:Name="PermissionsListView" ItemsSource="{Binding CurrentPermissions}"
                  SelectionMode="Extended"
                  BorderThickness="1"
                  BorderBrush="#004166"
                  Background="White">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Target ODS Practice / *" DisplayMemberBinding="{Binding TargetPracticeName}" Width="200"/>
                        <GridViewColumn Header="Permission Level" DisplayMemberBinding="{Binding PermissionLevel}" Width="150"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0" VerticalAlignment="Center">

            <Button Content="Assign Access to Selected ODS"
             ToolTip="Assigns default 'Viewer' access to the selected User for the selected ODS Practice."
             Width="300" Height="50" Margin="0,0,10,0"
             Command="{Binding AssignPermissionCommand}"
             Style="{StaticResource SupportButtonTheme}"/>

            <Button Content="Assign Access to ALL ODS"
             ToolTip="Assigns default 'Viewer' access to the selected User for ALL available ODS Practices."
             Width="300" Height="50" Margin="0,0,10,0"
             Command="{Binding AssignAllOdsCommand}"
             Style="{StaticResource SupportButtonTheme}" Background="DarkSeaGreen"/>

            <Button Content="Revoke Selected Permission(s)"
             ToolTip="Revokes the permission(s) selected in the list above."
             Width="250" Height="50" Margin="0,0,0,0"
             Command="{Binding RevokeSelectedCommand}"
             CommandParameter="{Binding SelectedItems, ElementName=PermissionsListView}"
             Style="{StaticResource SupportButtonTheme}" Background="OrangeRed"/>

        </StackPanel>

        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Foreground="#004166" FontStyle="Italic" Margin="0,10,0,0"/>

        <Grid Grid.Row="0" Grid.RowSpan="5" Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Processing..." HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#004166"/>
        </Grid>

    </Grid>
</UserControl>