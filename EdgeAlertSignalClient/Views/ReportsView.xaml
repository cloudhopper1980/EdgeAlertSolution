                                                <DataTemplate>
                                                    <TextBlock Text="{Binding LoggedIn}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <!-- Last Online Column -->
                                        <GridViewColumn Width="{Binding Path=ActualWidth, ElementName=ArchivedSystemInfoListView, Converter={StaticResource PercentageWidthConverter}, ConverterParameter=0.10}" Header="Last Online">
                                            <GridViewColumn.HeaderContainerStyle>
                                                <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource GridViewColumnHeaderBaseStyle}">
                                                    <Setter Property="Command" Value="{Binding DataContext.SortColumnCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                                                    <Setter Property="CommandParameter" Value="LastOnline,Archived" />
                                                </Style>
                                            </GridViewColumn.HeaderContainerStyle>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding LastOnline}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <!-- EdgeAlert Version Column -->
                                        <GridViewColumn Width="{Binding Path=ActualWidth, ElementName=ArchivedSystemInfoListView, Converter={StaticResource PercentageWidthConverter}, ConverterParameter=0.09}" Header="EdgeAlert Version">
                                            <GridViewColumn.HeaderContainerStyle>
                                                <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource GridViewColumnHeaderBaseStyle}">
                                                    <Setter Property="Command" Value="{Binding DataContext.SortColumnCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                                                    <Setter Property="CommandParameter" Value="Version,Archived" />
                                                </Style>
                                            </GridViewColumn.HeaderContainerStyle>
                                            <GridViewColumn.CellTemplate>
