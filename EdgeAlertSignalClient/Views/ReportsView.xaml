                                        <!-- EdgeAlert Version Column -->
                                        <GridViewColumn Width="{Binding Path=ActualWidth, ElementName=ActiveSystemInfoListView, Converter={StaticResource PercentageWidthConverter}, ConverterParameter=0.09}" Header="EdgeAlert Version">
                                            <GridViewColumn.HeaderContainerStyle>
                                                <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource GridViewColumnHeaderBaseStyle}">
