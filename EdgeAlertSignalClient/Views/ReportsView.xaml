                                </ListView.View>
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="18" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListView.GroupStyle>
                        </ListView>
                    </TabItem>

                    <!-- Archived Machines Tab -->
                    <TabItem Header="Archived Machines">
                        <ListView x:Name="ArchivedSystemInfoListView" 
                      ItemsSource="{Binding Source={StaticResource GroupedArchivedSystemInfo}}"
                      ItemContainerStyle="{StaticResource ReportViewListViewItemStyle}"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Visible">
                            <ListView.Resources>
                                <converters:PercentageWidthConverter x:Key="PercentageWidthConverter" />
                            </ListView.Resources>
                            <ListView.View>
                                    <GridView>
                                        <!-- Hostname Column -->
                                        <GridViewColumn Width="{Binding Path=ActualWidth, ElementName=ArchivedSystemInfoListView, Converter={StaticResource PercentageWidthConverter}, ConverterParameter=0.15}" Header="Hostname">
                                            <GridViewColumn.HeaderContainerStyle>
                                                <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource GridViewColumnHeaderBaseStyle}">
                                                    <Setter Property="Command" Value="{Binding DataContext.SortColumnCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                                                    <Setter Property="CommandParameter" Value="HostName,Archived" />
                                                </Style>
                                            </GridViewColumn.HeaderContainerStyle>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding HostName}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                            <!-- Serial Number Column -->
                                        <GridViewColumn Width="{Binding Path=ActualWidth, ElementName=ArchivedSystemInfoListView, Converter={StaticResource PercentageWidthConverter}, ConverterParameter=0.15}" Header="Serial">
                                            <GridViewColumn.HeaderContainerStyle>
                                                <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource GridViewColumnHeaderBaseStyle}">
                                                    <Setter Property="Command" Value="{Binding DataContext.SortColumnCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                                                    <Setter Property="CommandParameter" Value="SerialNumber,Archived" />
                                                </Style>
                                            </GridViewColumn.HeaderContainerStyle>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SerialNumber}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <!-- IP Address Column -->
                                        <GridViewColumn Width="{Binding Path=ActualWidth, ElementName=ArchivedSystemInfoListView, Converter={StaticResource PercentageWidthConverter}, ConverterParameter=0.11}" Header="IP Address">
                                            <GridViewColumn.HeaderContainerStyle>
                                                <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource GridViewColumnHeaderBaseStyle}">
                                                    <Setter Property="Command" Value="{Binding DataContext.SortColumnCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                                                    <Setter Property="CommandParameter" Value="IpAddress,Archived" />
                                                </Style>
                                            </GridViewColumn.HeaderContainerStyle>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding IpAddress}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <!-- Room Column -->
                                        <GridViewColumn Width="{Binding Path=ActualWidth, ElementName=ArchivedSystemInfoListView, Converter={StaticResource PercentageWidthConverter}, ConverterParameter=0.15}" Header="Room">
                                            <GridViewColumn.HeaderContainerStyle>
                                                <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource GridViewColumnHeaderBaseStyle}">
                                                    <Setter Property="Command" Value="{Binding DataContext.SortColumnCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                                                    <Setter Property="CommandParameter" Value="Room,Archived" />
                                                </Style>
                                            </GridViewColumn.HeaderContainerStyle>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Room}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <!-- Username Column -->
                                        <GridViewColumn Width="{Binding Path=ActualWidth, ElementName=ArchivedSystemInfoListView, Converter={StaticResource PercentageWidthConverter}, ConverterParameter=0.15}" Header="Name">
                                            <GridViewColumn.HeaderContainerStyle>
                                                <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource GridViewColumnHeaderBaseStyle}">
                                                    <Setter Property="Command" Value="{Binding DataContext.SortColumnCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                                                    <Setter Property="CommandParameter" Value="UserName,Archived" />
                                                </Style>
                                            </GridViewColumn.HeaderContainerStyle>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding UserName}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <!-- Operating System Column -->
                                        <GridViewColumn Width="{Binding Path=ActualWidth, ElementName=ArchivedSystemInfoListView, Converter={StaticResource PercentageWidthConverter}, ConverterParameter=0.30}" Header="Operating System">
                                            <GridViewColumn.HeaderContainerStyle>
                                                <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource GridViewColumnHeaderBaseStyle}">
                                                    <Setter Property="Command" Value="{Binding DataContext.SortColumnCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                                                    <Setter Property="CommandParameter" Value="OperatingSystem,Archived" />
                                                </Style>
                                            </GridViewColumn.HeaderContainerStyle>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding OperatingSystem}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <!-- Hard Drive Total Space Column -->
                                        <GridViewColumn Width="{Binding Path=ActualWidth, ElementName=ArchivedSystemInfoListView, Converter={StaticResource PercentageWidthConverter}, ConverterParameter=0.1}" Header="HD Total (GB)">
                                            <GridViewColumn.HeaderContainerStyle>
                                                <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource GridViewColumnHeaderBaseStyle}">
                                                    <Setter Property="Command" Value="{Binding DataContext.SortColumnCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                                                    <Setter Property="CommandParameter" Value="HardDriveTotalSpace,Archived" />
                                                </Style>
                                            </GridViewColumn.HeaderContainerStyle>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding HardDriveTotalSpace}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <!-- Hard Drive Free Space Column -->
                                        <GridViewColumn Width="{Binding Path=ActualWidth, ElementName=ArchivedSystemInfoListView, Converter={StaticResource PercentageWidthConverter}, ConverterParameter=0.1}" Header="HD Free (GB)">
                                            <GridViewColumn.HeaderContainerStyle>
                                                <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource GridViewColumnHeaderBaseStyle}">
                                                    <Setter Property="Command" Value="{Binding DataContext.SortColumnCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                                                    <Setter Property="CommandParameter" Value="HardDriveFreeSpace,Archived" />
                                                </Style>
                                            </GridViewColumn.HeaderContainerStyle>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding HardDriveFreeSpace}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <!-- RAM Capacity Column -->
                                        <GridViewColumn Width="{Binding Path=ActualWidth, ElementName=ArchivedSystemInfoListView, Converter={StaticResource PercentageWidthConverter}, ConverterParameter=0.08}" Header="RAM (GB)">
                                            <GridViewColumn.HeaderContainerStyle>
                                                <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource GridViewColumnHeaderBaseStyle}">
                                                    <Setter Property="Command" Value="{Binding DataContext.SortColumnCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                                                    <Setter Property="CommandParameter" Value="RamCapacity,Archived" />
                                                </Style>
                                            </GridViewColumn.HeaderContainerStyle>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding RamCapacity}" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>

                                        <!-- Manufacturer Column -->
                                        <GridViewColumn Width="{Binding Path=ActualWidth, ElementName=ArchivedSystemInfoListView, Converter={StaticResource PercentageWidthConverter}, ConverterParameter=0.20}" Header="Manufacturer">
                                            <GridViewColumn.HeaderContainerStyle>
                                                <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource GridViewColumnHeaderBaseStyle}">
