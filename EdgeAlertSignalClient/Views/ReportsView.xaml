                                    </GridView>
                                </ListView.View>
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="18" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListView.GroupStyle>
                        </ListView>
                    </TabItem>
                </TabControl>
            </TabItem>
        </TabControl>

        <!-- Bottom Row Left Empty for Your Command Controls -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <!-- ComboBox for selecting export format -->
            <ComboBox Grid.Column="1"
              SelectedValue="{Binding SelectedExportType, Mode=TwoWay}"
              SelectedValuePath="Content"
              Width="150"
              Height="30"
              Margin="0,0,10,0"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              VerticalContentAlignment="Center"
              HorizontalContentAlignment="Center">
                <ComboBoxItem Content="Excel"/>
                <ComboBoxItem Content="Word"/>
                <!-- Inline Style based on your existing visibility style -->
                <ComboBox.Style>
                    <Style TargetType="ComboBox">
                        <!-- Default display: white background, blue text -->
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Foreground" Value="#004166"/>
                    </Style>
                </ComboBox.Style>
                <!-- Define the style for the dropdown items -->
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <!-- Default dropdown items: light blue background, blue text -->
                        <Setter Property="Background" Value="LightBlue"/>
                        <Setter Property="Foreground" Value="#004166"/>
                        <Style.Triggers>
                            <!-- Hover effect: blue background with white text -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="LightBlue"/>
                                <Setter Property="Foreground" Value="#004166"/>
                            </Trigger>
                            <!-- Selected item effect: blue background with white text -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Black"/>
                                <Setter Property="Foreground" Value="#004166"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.ItemContainerStyle>
            </ComboBox>

            <Button Content="Export" 
                Command="{Binding ExportCommand}"
                CommandParameter="{Binding SelectedExportType}"
                IsEnabled="{Binding ButtonsEnabled}"
                Width="100" 
                Height="30" 
                Grid.Column="2"
                HorizontalAlignment="Right" 
                VerticalAlignment="Center"
                Background="{StaticResource ButtonBackgroundBrush}"
                Foreground="{StaticResource ButtonForegroundBrush}"
                FontWeight="Bold"/>
            <Button Content="Print" 
                Command="{Binding PrintCommand}"
                CommandParameter="{Binding SelectedExportType}"
                IsEnabled="{Binding ButtonsEnabled}"
                Width="100" 
                Height="30" 
                Grid.Column="3"
                HorizontalAlignment="Right" 
                VerticalAlignment="Center"
                Background="{StaticResource ButtonBackgroundBrush}"
                Foreground="{StaticResource ButtonForegroundBrush}"
                FontWeight="Bold"/>
            <Button Content="Refresh" 
                Command="{Binding RefreshCommand}"
                CommandParameter="{Binding SelectedExportType}"
                IsEnabled="{Binding ButtonsEnabled}"
                Width="100" 
                Height="30" 
                Grid.Column="0"
                HorizontalAlignment="Left" 
                VerticalAlignment="Center"
                Background="{StaticResource ButtonBackgroundBrush}"
                Foreground="{StaticResource ButtonForegroundBrush}"
                FontWeight="Bold"/>

        </Grid>

    </Grid>
</UserControl>
