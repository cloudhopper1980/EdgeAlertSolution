<UserControl x:Class="EdgeAlertSignalClient.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EdgeAlertSignalClient.Views"
             xmlns:converters="clr-namespace:EdgeAlertSignalClient.Converters" 
             xmlns:viewmodels="clr-namespace:EdgeAlertSignalClient.ViewModels" 
             d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:BooleanToImageConverter x:Key="BooleanToImageConverter" />
        <converters:PercentageWidthConverter x:Key="PercentageWidthConverter" />
        <converters:MatchToBooleanConverter x:Key="MatchToBooleanConverter" />
        <converters:SelectedAlertToVisibilityConverter x:Key="SelectedAlertToVisibilityConverter" />
        <converters:ResponderAlertBackgroundConverter x:Key="ResponderAlertBackgroundConverter"/>
        <converters:SelectedResponseToVisibilityConverter x:Key="SelectedResponseToVisibilityConverter"/>
        <converters:StringToBooleanConverter x:Key="StringToBooleanConverter" />
        <converters:HasEmptyResponderConverter x:Key="HasEmptyResponderConverter" />
        <converters:HasNonEmptyResponderConverter x:Key="HasNonEmptyResponderConverter" />

        <Style x:Key="HighlightedListViewItem" TargetType="{x:Type ListViewItem}">
            <Setter Property="Background" Value="Yellow"/>
        </Style>

        <!-- Define the base style for all GridViewColumnHeaders -->
        <Style x:Key="GridViewColumnHeaderBaseStyle" TargetType="GridViewColumnHeader">
            <!-- Set header background to the desired color -->
            <Setter Property="Background" Value="#004166"/>
            <!-- Set header foreground (text color) to white -->
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Column="0"
            Grid.Row="0"
            Height="40"
            VerticalAlignment="Top"
            Background="#E2F0D9">
            <Grid>
                <Grid.Resources>
                    <Style x:Key="ODSVisibilityStyle" TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=BlankIPAddress}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="ComboBoxVisibilityStyle" TargetType="{x:Type ComboBox}">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=BlankIPAddress}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                   Text="{Binding Path=UserName}"
                   Foreground="#004166"
                   FontSize="14"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="10"/>
                <TextBlock Grid.Column="1"
                   Style="{StaticResource ODSVisibilityStyle}"
                   Text="{Binding Path=ODS}"
                   Foreground="#004166"
                   FontSize="14"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="10"/>
                <!-- First ComboBox -->
                <ComboBox Grid.Column="1"
          FontSize="14"
          FontWeight="Bold"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Margin="10"
          Width="180"
          ItemsSource="{Binding Path=BlankIPODS}"
          SelectedItem="{Binding Path=SelectedBlankIPODS, Mode=TwoWay}"
          SelectedIndex="{Binding Path=ODSIndex}">
                    <!-- Inline Style based on your existing visibility style -->
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxVisibilityStyle}">
                            <!-- Default display: white background, blue text -->
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#004166"/>
                        </Style>
                    </ComboBox.Style>
                    <!-- Define the style for the dropdown items -->
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <!-- Default dropdown items: light blue background, blue text -->
                            <Setter Property="Background" Value="LightBlue"/>
                            <Setter Property="Foreground" Value="#004166"/>
                            <Style.Triggers>
                                <!-- Hover effect: blue background with white text -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="LightBlue"/>
                                    <Setter Property="Foreground" Value="#004166"/>
                                </Trigger>
                                <!-- Selected item effect: blue background with white text -->
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Black"/>
                                    <Setter Property="Foreground" Value="#004166"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>

                <!-- Second ComboBox -->
                <ComboBox Grid.Column="2"
          FontSize="14"
          FontWeight="Bold"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Margin="10"
          Width="180"
          ItemsSource="{Binding Path=Rooms}"
          SelectedItem="{Binding Path=SelectedRoom, Mode=TwoWay}"
          SelectedIndex="{Binding Path=RoomIndex}"
          IsEnabled="{Binding Path=RoomEnabled}">
                    <!-- Inline Style based on your existing visibility style -->
                    <ComboBox.Style>
                        <Style TargetType="ComboBox">
                            <!-- Default display: white background, blue text -->
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="#004166"/>
                        </Style>
                    </ComboBox.Style>
                    <!-- Define the style for the dropdown items -->
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <!-- Default dropdown items: light blue background, blue text -->
                            <Setter Property="Background" Value="LightBlue"/>
                            <Setter Property="Foreground" Value="#004166"/>
                            <Style.Triggers>
                                <!-- Hover effect: blue background with white text -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="LightBlue"/>
                                    <Setter Property="Foreground" Value="#004166"/>
                                </Trigger>
                                <!-- Selected item effect: blue background with white text -->
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Black"/>
                                    <Setter Property="Foreground" Value="#004166"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>

            </Grid>
        </StackPanel>

        <!-- Main ListView Grid -->
        <Grid x:Name="ListViewGrid" 
              Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="231*"/>
                <ColumnDefinition Width="569*"/>
            </Grid.ColumnDefinitions>
            <ListView x:Name="EdgeUsers"
                      Background="#CDEAFB"
                      ItemsSource="{Binding Path=EdgeUsers}"
                      SelectedItem="{Binding Path=SelectedEdgeUser}" Grid.ColumnSpan="2">
                <ListView.Resources>
                    <Style TargetType="{x:Type ListViewItem}">
                        <Setter Property="MinHeight" Value="60" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Background">
                            <Setter.Value>
                                <MultiBinding Converter="{StaticResource ResponderAlertBackgroundConverter}">
                                    <Binding Path="Alert" />
                                    <Binding Path="Responders" />
                                </MultiBinding>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Foreground" Value="Black" />
                        <Setter Property="FontWeight" Value="Normal" />
                        <Style.Triggers>
                            <!-- Trigger for mouse-over -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#A5D8F3" />
                                <Setter Property="Foreground" Value="#004166" />
                            </Trigger>
                            <!-- Trigger for selected item -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#A5D8F3" />
                                <Setter Property="Foreground" Value="#004166" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="CenteredTextBlock" TargetType="{x:Type TextBlock}">
                        <Setter Property="HorizontalAlignment" Value="Center" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                    <Style x:Key="LeftAlignTextBlock" TargetType="{x:Type TextBlock}">
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </ListView.Resources>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="{Binding Path=ActualWidth, ElementName=EdgeUsers, Converter={StaticResource PercentageWidthConverter}, ConverterParameter=0.12}" Header="User Name">
                            <GridViewColumn.HeaderContainerStyle>
                                <Style TargetType="GridViewColumnHeader"
                                       BasedOn="{StaticResource GridViewColumnHeaderBaseStyle}" />
                            </GridViewColumn.HeaderContainerStyle>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding UserName}" Style="{StaticResource LeftAlignTextBlock}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="{Binding Path=ActualWidth, ElementName=EdgeUsers, Converter={StaticResource PercentageWidthConverter}, ConverterParameter=0.10}" Header="Device">
                            <GridViewColumn.HeaderContainerStyle>
                                <Style TargetType="GridViewColumnHeader"
                                       BasedOn="{StaticResource GridViewColumnHeaderBaseStyle}" />
                            </GridViewColumn.HeaderContainerStyle>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding HostName}" Style="{StaticResource LeftAlignTextBlock}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="{Binding Path=ActualWidth, ElementName=EdgeUsers, Converter={StaticResource PercentageWidthConverter}, ConverterParameter=0.20}" Header="Room">
                            <GridViewColumn.HeaderContainerStyle>
                                <Style TargetType="GridViewColumnHeader"
                                       BasedOn="{StaticResource GridViewColumnHeaderBaseStyle}" />
                            </GridViewColumn.HeaderContainerStyle>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Room}" Style="{StaticResource LeftAlignTextBlock}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="{Binding Path=ActualWidth, ElementName=EdgeUsers, Converter={StaticResource PercentageWidthConverter}, ConverterParameter=0.08}" Header="Connected">
                            <GridViewColumn.HeaderContainerStyle>
                                <Style TargetType="GridViewColumnHeader"
                                       BasedOn="{StaticResource GridViewColumnHeaderBaseStyle}" />
                            </GridViewColumn.HeaderContainerStyle>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentPresenter HorizontalAlignment="Center">
                                        <ContentPresenter.Content>
                                            <Image HorizontalAlignment="Center" Width="32" Height="32" Margin="4">
                                                <Image.Source>
                                                    <MultiBinding Converter="{StaticResource BooleanToImageConverter}">
                                                        <Binding Path="Connected"/>
                                                        <Binding Path="LastOnline"/>
                                                    </MultiBinding>
                                                </Image.Source>
                                            </Image>
                                        </ContentPresenter.Content>
                                    </ContentPresenter>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="{Binding Path=ActualWidth, ElementName=EdgeUsers, Converter={StaticResource PercentageWidthConverter}, ConverterParameter=0.12}" Header="Last Online">
                            <GridViewColumn.HeaderContainerStyle>
                                <Style TargetType="GridViewColumnHeader"
                                       BasedOn="{StaticResource GridViewColumnHeaderBaseStyle}" />
                            </GridViewColumn.HeaderContainerStyle>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding LastOnline}" Style="{StaticResource CenteredTextBlock}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="{Binding Path=ActualWidth, ElementName=EdgeUsers, Converter={StaticResource PercentageWidthConverter}, ConverterParameter=0.12}" Header="Alert">
                            <GridViewColumn.HeaderContainerStyle>
                                <Style TargetType="GridViewColumnHeader"
                                       BasedOn="{StaticResource GridViewColumnHeaderBaseStyle}" />
                            </GridViewColumn.HeaderContainerStyle>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Alert}" Style="{StaticResource CenteredTextBlock}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="{Binding Path=ActualWidth, ElementName=EdgeUsers, Converter={StaticResource PercentageWidthConverter}, ConverterParameter=0.12}" Header="Responders">
                            <GridViewColumn.HeaderContainerStyle>
                                <Style TargetType="GridViewColumnHeader"
                                       BasedOn="{StaticResource GridViewColumnHeaderBaseStyle}" />
                            </GridViewColumn.HeaderContainerStyle>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ItemsControl ItemsSource="{Binding Responders}" VerticalAlignment="Center">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Vertical">
                                                    <TextBlock Text="{Binding ResponderName}" Style="{StaticResource CenteredTextBlock}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <!-- New Actions Column with improved visibility logic -->
                        <GridViewColumn Width="{Binding Path=ActualWidth, ElementName=EdgeUsers, Converter={StaticResource PercentageWidthConverter}, ConverterParameter=0.14}" Header="Actions">
                            <GridViewColumn.HeaderContainerStyle>
                                <Style TargetType="GridViewColumnHeader"
                BasedOn="{StaticResource GridViewColumnHeaderBaseStyle}" />
                            </GridViewColumn.HeaderContainerStyle>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- Action buttons for each row -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!-- Respond Button - Visible when alert exists, not your own alert, and you haven't responded yet -->
                                        <Button Content="Respond" 
                        Width="78"
                        Height="30"
                        Margin="2"
                        FontWeight="Bold"
                        Background="#4CAF50"
                        Foreground="White"
                        Command="{Binding DataContext.RespondToRowCommand, 
                                RelativeSource={RelativeSource AncestorType=ListView}}"
                        CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <!-- Alert exists -->
                                                                <Condition Binding="{Binding Alert, Converter={StaticResource StringToBooleanConverter}}" Value="True"/>
                                                                <!-- Not the current user -->
                                                                <Condition Binding="{Binding IsCurrentUser}" Value="False"/>
                                                                <!-- Current user has not responded yet -->
                                                                <Condition Binding="{Binding HasCurrentUserResponded}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <!-- Stop Alert Button - Visible when alert exists and the current user has already responded -->
                                        <Button Content="Stop Alert" 
                        Width="78"
                        Height="30"
                        Margin="2"
                        FontWeight="Bold"
                        Background="#F44336"
                        Foreground="White"
                        Command="{Binding DataContext.StopAlertForRowCommand, 
                                RelativeSource={RelativeSource AncestorType=ListView}}"
                        CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <!-- Alert exists -->
                                                                <Condition Binding="{Binding Alert, Converter={StaticResource StringToBooleanConverter}}" Value="True"/>
                                                                <!-- Not the current user -->
                                                                <Condition Binding="{Binding IsCurrentUser}" Value="False"/>
                                                                <!-- Current user has already responded -->
                                                                <Condition Binding="{Binding HasCurrentUserResponded}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <!-- Bottom Section -->
        <Grid Grid.Row="2" Background="#E2F0D9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Column: Stationary Device Checkbox -->
            <CheckBox Grid.Column="0"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     Content="Stationary Device"
                     Foreground="#004166"
                     IsChecked="{Binding Path=StationaryDevice, Mode=TwoWay}"
                     IsEnabled="{Binding Path=StationaryDeviceIsEnabled}"/>

            <!-- Middle Column: Alert Icon with Label -->
            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Height="50"
                        Width="50"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="5,5,5,1"
                        CornerRadius="50"
                        BorderThickness="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="BorderBrush" Value="#003f66"/>
                            <!-- Default color -->

                            <Style.Triggers>
                                <!-- Trigger for red border when alert is set -->
                                <DataTrigger Binding="{Binding AlertHasBeenSet}" Value="True">
                                    <Setter Property="BorderBrush" Value="#cd1f25"/>
                                    <!-- Red color -->
                                </DataTrigger>

                                <!-- Trigger for yellow border when alert is set and there is a responder -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ResponderHasBeenSet}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="BorderBrush" Value="#ffbf00"/>
                                    <!-- Yellow color -->
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding DoubleClickAlertCommand}" />
                        <MouseBinding MouseAction="RightClick" Command="{Binding RightClickCloseCommand}" />
                    </Border.InputBindings>
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Margin="2" Source="pack://application:,,,/Resources/edgebits_icon.png"/>
                    </Grid>
                </Border>
                <!-- Added label to explain the button's function -->
                <TextBlock Text="Double-click to Trigger Alert" 
                           HorizontalAlignment="Center" 
                           Foreground="#004166" 
                           FontSize="10"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,0,0,2"/>
            </StackPanel>

            <!-- Right Column: Buttons -->
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Mute Button -->
                <Button Content="Mute Sound"
                        Width="90"
                        Height="40"
                        FontWeight="Bold"
                        FontSize="12"
                        Grid.Column="0"                        
                        Visibility="{Binding StopButtonVisibility}"
                        Command="{Binding StopAlarmCommand}"
                        Background="#FF9800"
                        Foreground="White"
                        HorizontalAlignment="Center">
                    <Button.ToolTip>
                        <ToolTip>
                            <TextBlock Text="Stops the alert sound on your device only. Does not cancel the alert." 
                                      TextWrapping="Wrap" 
                                      Width="200"/>
                        </ToolTip>
                    </Button.ToolTip>
                </Button>

                <!-- OK/Close Button -->
                <Button Content="Ok"
                        Height="40"
                        Width="90"
                        FontWeight="Bold"
                        FontSize="16"
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        Background="{StaticResource ButtonBackgroundBrush}"
                        Foreground="{StaticResource ButtonForegroundBrush}"
                        Command="{Binding RightClickCloseCommand}"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>