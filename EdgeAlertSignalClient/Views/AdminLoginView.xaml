<UserControl x:Class="EdgeAlertSignalClient.Views.AdminLoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EdgeAlertSignalClient.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#E2F0D9">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="#004166" 
                Height="50">
            <TextBlock Text="Admin Authentication"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- Login Content -->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <Image Source="/Resources/edgebits_icon.png"
                   Width="100"
                   Height="100"
                   Margin="0,0,0,30"/>

            <TextBlock Text="Enter Administrator Password"
                       FontSize="16"
                       Margin="0,0,0,20"
                       Foreground="#004166"
                       HorizontalAlignment="Center"/>

            <PasswordBox x:Name="passwordBox" 
                         PasswordChanged="PasswordBox_PasswordChanged"
                         Width="300"
                         Height="40"
                         FontSize="16"
                         Margin="0,0,0,30"
                         VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Center">
                <FocusManager.FocusedElement>
                    <Binding ElementName="passwordBox"/>
                </FocusManager.FocusedElement>
            </PasswordBox>

            <Button Content="Login" 
                    Command="{Binding LoginCommand}"
                    Width="150"
                    Height="40"
                    FontSize="16"
                    FontWeight="Bold"
                    Background="#004166"
                    Foreground="White"
                    IsDefault="True"/>

            <!-- Error Message Area -->
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="Red"
                       FontSize="14"
                       Margin="0,20,0,0"
                       HorizontalAlignment="Center"
                       Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" 
                Background="#F0F0F0" 
                Height="50">
            <TextBlock Text="Access to administrative functions requires authentication"
                       Foreground="#004166"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>